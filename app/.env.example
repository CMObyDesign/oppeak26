# HighLevel (GHL) integration values for the CFO By Design funnel.
# Copy to .env and fill in real values, or set these as Cloudflare Pages
# build environment variables (which take precedence over .env at build
# time). None of these are secrets — they're public form/widget IDs and
# links already visible in the browser's network requests — but they're
# kept out of source so this repo isn't tied to one specific GHL location.
#
# See app/README.md for what each one does and where it's used.

VITE_GHL_LOCATION_ID=
VITE_GHL_CALENDAR_ID=
VITE_GHL_TRACKING_ID=
VITE_GHL_SURVEY_SUBMIT_URL=
VITE_GHL_BOOKING_API_BASE=

VITE_GHL_CF_REVENUE_ID=
VITE_GHL_CF_GOAL_ID=
VITE_GHL_CF_SCORE_ID=
VITE_GHL_CF_REPORT_PATH_ID=

VITE_PAYMENT_LINK_47=
VITE_PAYMENT_LINK_297=
VITE_BOOKING_LINK_297=

VITE_IMAGE_LOGO=
VITE_IMAGE_STRATEGIST_BG=

# Not env-driven — index.html's og:image/twitter:image and the favicon
# link are static tags pointing at local files under public/. Replace
# public/images/placeholder-og.svg (and public/favicon.svg) directly, or
# edit the <meta>/<link> tags in index.html to point at hosted URLs.
